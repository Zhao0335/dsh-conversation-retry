{
  "name": "dsh-conversation-retry",
  "version": "0.4.0",
  "type": "module",
  "description": "Edit a message you already sent and re-run from there, or retry a turn, in the DeepSeek Harness Web UI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "retry",
    "regenerate",
    "edit-message",
    "branch",
    "fork"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhao0335/dsh-conversation-retry.git"
  },
  "homepage": "https://github.com/Zhao0335/dsh-conversation-retry#readme",
  "bugs": {
    "url": "https://github.com/Zhao0335/dsh-conversation-retry/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "scripts/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
