{
  "name": "dsh-conversation-retry",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Retry a turn, edit the prompt and resend, or branch a new session from any completed turn in the DeepSeek Harness Web UI.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "retry",
    "regenerate",
    "branch",
    "fork"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
